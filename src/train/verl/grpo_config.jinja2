data:
    seed: {{ seed }}
    train_files: {{ train_dataset_parquet_path }}
    val_files: {{ validation_dataset_parquet_path }}
    train_batch_size: {{ train_batch_size }}
    max_prompt_length: {{ max_prompt_length }}
    max_response_length: {{ max_completion_length }}
    filter_overlong_prompts: true
    truncation: error
    shuffle: true
    prompt_key: prompt
    reward_fn_key: data_source
    val_batch_size: null
    apply_chat_template_kwargs: {{ chat_template_kwargs }}
    dataloader_num_workers: {{ dataloader_num_workers }}


actor_rollout_ref:
    model:
        path: {{ model_id }}
        lora_rank: {{ lora_rank }}
        lora_alpha: {{ lora_alpha }}
        target_modules: all-linear
        use_remove_padding: true
        enable_gradient_checkpointing: {{ enable_gradient_checkpointing }}
        use_shm: true
        use_liger: {{ use_liger }}
        use_fused_kernels: true
        gradient_routing:
            enabled: {{ gradient_routing_enabled }}
            label_field: {{ gradient_routing_label_field }}
            label_subsample_rate: {{ gradient_routing_label_subsample_rate }}
    actor:
        strategy: fsdp2
{% if profiler_enabled %}
        profiler:
            enable: true
            all_ranks: true
{% endif %}
        optim:
            optimizer: {{ "AdamW8bit" if optim == "adamw_8bit" else "AdamW" }}
            optimizer_impl: {{ "bitsandbytes.optim" if optim == "adamw_8bit" else "torch.optim" }}
            lr: {{ learning_rate }}
            lr_warmup_steps_ratio: {{ 0.0 if warmup_ratio is none else warmup_ratio }}
            lr_warmup_steps: {{ warmup_steps if warmup_steps is not none else -1 }}
            lr_scheduler_type: {{ "cosine" if lr_scheduler_type == "cosine" else "constant" }}
            weight_decay: {{ weight_decay }}
            betas: [{{ adam_beta1 }}, {{ adam_beta2 }}]
            clip_grad: {{ max_grad_norm }}
        ppo_mini_batch_size: {{ mini_batch_size }}
        ppo_micro_batch_size_per_gpu: {{ per_device_batch_size }}
        use_dynamic_bsz: {{ use_dynamic_bsz }}
        ppo_max_token_len_per_gpu: {{ ppo_max_token_len_per_gpu }}
        loss_agg_mode: seq-mean-token-sum  # Each sequence weighted equally, compatible with dynamic batching
        use_kl_loss: {{ use_kl_loss | lower }}
        kl_loss_coef: {{ beta }}
        kl_loss_type: low_var_kl
        policy_loss:
            loss_mode: "{{ policy_loss_mode }}"
        fsdp_config:
            fsdp_size: 1
            param_offload: false # MODIFIED
            optimizer_offload: false # MODIFIED
            model_dtype: bfloat16
            dtype: bfloat16
        ulysses_sequence_parallel_size: 1
        checkpoint:
            save_contents: {{ checkpoint_save_contents }}
            load_contents: ${.save_contents}
    rollout:
        log_prob_micro_batch_size_per_gpu: {{ per_device_batch_size }}
        tensor_model_parallel_size: 1
        name: {{ rollout_engine }}
        mode: sync
        gpu_memory_utilization: {{ gpu_memory_utilization }}
        n: {{ num_generations }}
        max_num_seqs: {{ max_num_seqs }}
        max_model_len: {{ max_prompt_length + max_completion_length }}
        max_num_batched_tokens: {{ max_num_batched_tokens }}
        enable_chunked_prefill: false
        layered_summon: true
        load_format: safetensors # Required for LoRa
        dtype: bfloat16
        temperature: {{ temperature }}
        top_p: {{ top_p }}
        calculate_log_probs: {{ calculate_rollout_log_probs | lower }}
        disable_log_stats: false  # Enable vLLM stats logging for throughput analysis
        free_cache_engine: {{ free_cache_engine | default(true) }}  # Can be disabled to reduce overhead
        engine_kwargs:
            vllm: {}
    ref:
        log_prob_micro_batch_size_per_gpu: {{ per_device_batch_size }}
        fsdp_config:
            param_offload: true

reward_model:
    reward_kwargs: 
        seed: {{ seed }}
        reward_specs: {{ reward_funcs_kwargs }}

algorithm:
    use_kl_in_reward: false
    kl_ctrl:
        kl_coef: {{ beta }}
    screening_specs: {{ screening_funcs_kwargs }}
{% if bypass_mode or rollout_is or rollout_rs %}
    # Rollout correction: off-policy correction for stale rollouts
    rollout_correction:
        bypass_mode: {{ bypass_mode | lower }}
{% if rollout_is %}
        rollout_is: "{{ rollout_is }}"
        rollout_is_threshold: {{ rollout_is_threshold }}
{% endif %}
{% if rollout_rs %}
        rollout_rs: "{{ rollout_rs }}"
        rollout_rs_threshold: {{ rollout_rs_threshold }}
        rollout_rs_threshold_lower: {{ 1.0 / rollout_rs_threshold }}
{% endif %}
{% endif %}

trainer:
    total_epochs: {{ total_epochs }}
    total_training_steps: {{ max_steps }}
    critic_warmup: 0
    logger: ["console", "{{ report_to }}"] # NOTE: Other options potentially not supported by Verl
    project_name: {{ wandb_project }}
    experiment_name: {{ run_name }}
    n_gpus_per_node: {{ n_gpus }}
    nnodes: 1
    save_freq: {{ save_steps }}
    test_freq: -1
    default_local_dir: {{ output_dir }}/checkpoints
    rollout_data_dir: {{ output_dir }}/rollouts
    max_actor_ckpt_to_keep: {{ save_total_limit }}
    debug_oom: {{ debug_oom | lower }}

{% if profiler_enabled %}
# Profiler configuration
global_profiler:
    tool: {{ profiler_tool }}
    steps: {{ profiler_steps }}
    profile_continuous_steps: false
    save_path: {{ output_dir }}/profiles
{% if profiler_tool == "nsys" %}
    global_tool_config:
        nsys:
            discrete: {{ profiler_discrete | lower }}
            controller_nsight_options:
                trace: "cuda,nvtx,cublas"
                cuda-memory-usage: "true"
                cuda-graph-trace: "graph"
            worker_nsight_options:
                trace: "cuda,nvtx,cublas"
                cuda-memory-usage: "true"
                cuda-graph-trace: "graph"
                capture-range: "cudaProfilerApi"
                capture-range-end: null
                kill: none
{% elif profiler_tool == "torch_memory" %}
    global_tool_config:
        torch_memory:
            trace_alloc_max_entries: 100000
            stack_depth: 32
            context: "all"
            stacks: "all"
{% endif %}
{% endif %}

# Custom extension: activation cache worker config (not used by core verl)
activation_cache:
    enabled: {{ cache_activations }}
    layers: {{ cache_activations_layers }}
    position: {{ cache_activations_position }}
    batch_size: {{ per_device_batch_size }}
